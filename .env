# Used by frontend .env
# Production backend URL (default)
REACT_APP_API_URL=https://backend-seven-steel-46.vercel.app
# Local backend URL — override this in .env.local for local development
REACT_APP_API_LOCAL_URL=http://localhost:5500
REACT_APP_ENV=production

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FILE=/var/log/ecommerce-app/backend.log

# ==================== SESSION ====================
SESSION_SECRET=your_session_secret_key_at_least_32_chars

# ==================== REDIS (optional - for caching) ====================
REDIS_URL=redis://localhost:6379

# ==================== MONITORING ====================
# New Relic APM (optional)
NEW_RELIC_LICENSE_KEY=your_newrelic_key

# ==================== TIMEZONE ====================
TZ=Asia/Kolkata