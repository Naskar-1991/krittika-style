# Backend Environment Variables
# Copy this to .env and fill in your actual values

# ============ Razorpay Payment Gateway ============
# Get from: https://dashboard.razorpay.com/app/dashboard
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ============ JWT Authentication ============
JWT_SECRET=your_secure_jwt_secret_here

# ============ Twilio OTP Configuration ============
# Get these from: https://www.twilio.com/console
# Your Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio Phone Number (format: +1234567890 or +919876543210 for India)
# This is the phone number from which OTP SMS will be sent
TWILIO_PHONE_NUMBER=+1234567890

# OTP Expiration time in minutes (default: 10)
OTP_EXPIRY_MINUTES=10

# Maximum number of OTP verification attempts (default: 3)
MAX_OTP_ATTEMPTS=3

# ============ Database Configuration ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=your_database_password

# ============ Server Port ============
PORT=5500

